{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/servicos",
      "destination": "/servicos/index.html"
    },
    {
      "source": "/servicos/web-e-sistemas",
      "destination": "/servicos/web-e-sistemas/index.html"
    },
    {
      "source": "/servicos/ia-integrada",
      "destination": "/servicos/ia-integrada/index.html"
    },
    {
      "source": "/servicos/automacao",
      "destination": "/servicos/automacao/index.html"
    },
    {
      "source": "/perguntas-frequentes",
      "destination": "/perguntas-frequentes/index.html"
    },
    {
      "source": "/sobre",
      "destination": "/sobre/index.html"
    },
    {
      "source": "/contato",
      "destination": "/contato/index.html"
    },
    {
      "source": "/politicas",
      "destination": "/politicas/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/praxe",
      "destination": "https://praxeskills.com/",
      "permanent": false
    },
    {
      "source": "/blog",
      "destination": "https://blog.ibaestudio.com/",
      "permanent": true
    },
    {
      "source": "/blog/:caminho*",
      "destination": "https://blog.ibaestudio.com/:caminho*",
      "permanent": true
    }
  ]
}
